.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--glass);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(36, 49, 42, 0.08);
}

/* 导航箭头（CSS） */
.ic-nav {
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-bottom: 22rpx solid #2F6B4C;
  transform: rotate(18deg) translateY(-2rpx);
}

.screen {
  padding: 24rpx 40rpx calc(200rpx + env(safe-area-inset-bottom));
}

/* ------------------------------------------------------------------ 插画
   点位插画是「手撕纸片」式的裁切碎片，长宽比差异很大（有的很扁、有的近方）。
   原来给固定 400×400rpx 的盒子 + aspectFit，扁的插画只占中间一小条，
   整张卡大面积留空，主视觉发飘。改成让插画撑满卡片可用区：
   扁的走宽度、方/高的走高度，两种情况都能占满。 */
.hero {
  position: relative;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-ic {
  width: 100%;
  height: 100%;
}

.hero-chip {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* ------------------------------------------------------------------ 邮戳
   打过卡的标记不再是原来的金黄印章，而是一枚「邮戳」：
   外圈粗、内圈细，中间「已打卡」，下面月-日。
   纯 CSS 画（圆 + currentColor 描边），颜色跟当前线路的主色走；
   `stamp-anim` 让它像真的盖下去一样缩放落定。 */
.pmark {
  position: absolute;
  right: 40rpx;
  bottom: 32rpx;
  width: 196rpx;
  height: 196rpx;
  border-radius: 50%;
  border: 7rpx solid currentColor;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0.92;
}

.pm-ring {
  position: absolute;
  left: 13rpx;
  top: 13rpx;
  right: 13rpx;
  bottom: 13rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  opacity: 0.7;
}

.pm-t {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-left: 4rpx;   /* 抵消末字后的字距，视觉居中 */
  line-height: 1.1;
}

.pm-d {
  font-size: 20rpx;
  line-height: 1;
  margin-top: 8rpx;
  opacity: 0.85;
}

.hw1 {
  left: -16rpx;
  top: 20rpx;
  width: 160rpx;
  height: 44rpx;
  transform: rotate(-7deg);
}

.hw2 {
  right: -20rpx;
  bottom: 26rpx;
  width: 140rpx;
  height: 40rpx;
  transform: rotate(6deg);
}

/* ------------------------------------------------------------------ 标题 */
.head {
  padding: 34rpx 4rpx 6rpx;
}

.nm {
  display: block;
  font-size: 52rpx;
  line-height: 1.25;
  color: var(--t1);
}

.st {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.st-t {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--t3);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--cream);
}

.st-t.done {
  color: #fff;
  background: var(--gold);
}

.st-d {
  font-size: 22rpx;
  color: var(--t3);
}

.st-at {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--t3);
}

/* ------------------------------------------------------------------ 区块卡 */
.sec {
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
}

.sec-h {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--t1);
  margin-bottom: 12rpx;
}

.sec-b {
  display: block;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--t2);
}

.sec-note {
  display: block;
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 2rpx;
  margin-bottom: 6rpx;
}

.ln {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 92rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  margin-top: 14rpx;
}

.ln:first-of-type {
  margin-top: 18rpx;
}

.ln-n {
  font-size: 26rpx;
  font-weight: 700;
}

.ln-s {
  flex: 1;
  font-size: 21rpx;
  color: var(--t2);
}

.ln-ar {
  font-size: 21rpx;
  font-weight: 600;
}

/* 这条线路上的盖章状态 */
.ln-st {
  flex: none;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 40rpx;
  color: var(--t3);
  background: var(--glass-lit);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
}

.ln-st.on {
  color: #fff;
  background: var(--gold);
}

/* ------------------------------------------------------------------ 附近 */
.nwrap {
  width: 100%;
  white-space: nowrap;
}

.nrow {
  display: flex;
  gap: 24rpx;
  padding: 0 40rpx;
}

.nc {
  width: 200rpx;
  flex: none;
}

.nc-img {
  position: relative;
  width: 200rpx;
  height: 156rpx;
  border-radius: 28rpx;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.nc-ic {
  width: 140rpx;
  height: 140rpx;
}

.nc-nm {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--t1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tail {
  padding: 60rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--t3);
}

/* ------------------------------------------------------------------ 底部行动条 */
/* 底部行动条已提为全局 .actionbar / .actionbar .btn（见 app.wxss），
   活动详情页共用同一套。 */

/* ------------------------------------------------------------------ 打卡弹窗 */
/* 普通打卡：邮戳 + 「盖章成功 / 地点已记进你的手账本」两行，都居中 */
.dlmark {
  position: relative;
  right: auto;
  bottom: auto;
  width: 220rpx;
  height: 220rpx;
  border-width: 8rpx;
  margin: 0 auto 26rpx;
}

.dlmark .pm-ring {
  left: 15rpx;
  top: 15rpx;
  right: 15rpx;
  bottom: 15rpx;
  border-width: 4rpx;
}

.dlmark .pm-t {
  font-size: 42rpx;
}

.dlmark .pm-d {
  font-size: 22rpx;
}

/* 走完一条线路：成就章放大展示 */
.dl-k {
  display: block;
  font-size: 24rpx;
  color: var(--t3);
  margin-bottom: 20rpx;
}

/* ------------------------------------------------------------------ 徽章发放动画
   走完整条线时，成就章是「发」出来的，不是简单弹出来：
   徽章从掌心大小带一点旋转弹跳落定 → 暖光炸开、落定后留一层柔光
   → 两圈细环各回响两次往外荡 → 四道金芒斜向抽出 → 文案逐行浮现
   → 落定后徽章轻轻浮动。全部纯 CSS keyframes，每层各管各的 transform，互不覆盖。

   ⚠️ 关键几何：徽章本体占满 380rpx（半径 190rpx），
   所有光效的**半径必须大于 190rpx**，否则整层都被徽章自己盖住 —— 等于白做
   （第一版金芒在 r=176、光晕 r=165，就是这个错，动画完全看不见）。 */
.bb-stage {
  position: relative;
  width: 380rpx;
  height: 380rpx;
  margin: 0 auto 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 背后的暖光：先炸亮一下，然后**留一层柔光**不散 —— 静止时也是「刚发下来」的样子 */
.bb-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 540rpx;
  height: 540rpx;
  margin: -270rpx 0 0 -270rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 180, 74, 0.5) 0%, rgba(232, 180, 74, 0) 62%);
  opacity: 0;
  animation: bb-glow 1.8s ease-out 0.3s both;
}

@keyframes bb-glow {
  0% { opacity: 0; transform: scale(0.72); }
  38% { opacity: 1; transform: scale(1); }
  100% { opacity: 0.66; transform: scale(1.06); }
}

/* 两圈细环：从徽章边缘往外推（160 → 300rpx），各回响两次，
   整个「发放」过程约 4.8 秒，不会一眨眼就错过。 */
.bb-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 400rpx;
  height: 400rpx;
  margin: -200rpx 0 0 -200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(201, 146, 43, 0.62);
  opacity: 0;
  animation: bb-halo 2s ease-out 0.26s 2 both;
}

.bb-halo.d2 {
  border-color: rgba(238, 123, 60, 0.5);
  animation-delay: 0.8s;
}

@keyframes bb-halo {
  0% { opacity: 0; transform: scale(0.82); }
  20% { opacity: 1; }
  100% { opacity: 0; transform: scale(1.5); }
}

/* 四道金芒：只走斜向 —— 正上/正下的会撞到上面那行小字。
   外层管方向（静态旋转），内层管伸缩：两层各动各的 transform，互不覆盖。 */
.ray {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}

.ray.r1 { transform: rotate(45deg); }
.ray.r2 { transform: rotate(135deg); }
.ray.r3 { transform: rotate(225deg); }
.ray.r4 { transform: rotate(315deg); }

.ray-i {
  position: absolute;
  left: -5rpx;
  top: -252rpx;
  width: 10rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(232, 180, 74, 0) 0%, #E8B44A 58%, #F4D48C 100%);
  opacity: 0;
  animation: ray-grow 1.1s ease-out 0.4s both;
}

/* 起点 r≈194（贴着徽章边缘，像从章底下抽出来），终点 r≈274 */
@keyframes ray-grow {
  0% { opacity: 0; transform: translateY(58rpx) scaleY(0.25); }
  38% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx) scaleY(1); }
}

/* 徽章本体：带过冲的弹跳落定，落定后轻轻浮动 */
.bigbadge {
  position: relative;
  width: 380rpx;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: bb-pop 0.85s cubic-bezier(0.2, 1.45, 0.36, 1) both,
             bb-float 2.8s ease-in-out 1.1s infinite;
}

@keyframes bb-pop {
  0% { opacity: 0; transform: scale(0.25) rotate(-22deg); }
  55% { opacity: 1; transform: scale(1.12) rotate(5deg); }
  76% { transform: scale(0.96) rotate(-2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes bb-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 文案跟着徽章落定逐行冒出来 */
@keyframes bb-txt {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.bb-k { animation: bb-txt 0.4s ease-out 0.06s both; }
.bb-name { animation: bb-txt 0.45s ease-out 0.16s both; }
.bb-desc { animation: bb-txt 0.5s ease-out 0.28s both; }
.bb-cond { animation: bb-txt 0.5s ease-out 0.38s both; }

.bb-img {
  width: 100%;
  height: 100%;
}

.bb-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--t2);
  margin-top: 4rpx;
}

.bb-cond {
  display: block;
  font-size: 21rpx;
  color: var(--t3);
  margin-top: 14rpx;
  margin-bottom: 28rpx;
}

.dl-btn {
  width: 100%;
  margin-top: 28rpx;
}
