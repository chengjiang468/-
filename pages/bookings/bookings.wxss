/* ============================================================================
   我的预约 —— 与「预约体验」同一套拼贴手账语言（卡 r48、内衬 r28、胶囊 999）
   版式：左侧小封面（200×150）+ 右侧标题/时间/日期+取消，一行一场，扫得快
   ========================================================================== */

.sec-head {
  margin-top: 40rpx;
  margin-bottom: 26rpx;
}

.sec-title {
  font-size: 34rpx;
}

/* ------------------------------------------------------------------ 预约卡 */
.blist {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.bcard {
  display: flex;
  align-items: stretch;
  padding: 22rpx;
}

.bthumb {
  width: 200rpx;
  height: 168rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--cream);
  flex: none;
}

.bthumb-i {
  width: 100%;
  height: 100%;
  display: block;
}

.bcol {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.btitle {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--t1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bmeta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.bmeta-t {
  font-size: 21rpx;
  color: var(--t3);
  margin-left: 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 日期贴纸 + 取消胶囊各占一端 */
.bfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.bday {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--cream);
  display: flex;
  align-items: center;
}

.bday .num {
  font-size: 21rpx;
  color: var(--t1);
  line-height: 1;
}

/* 取消是「减法动作」，用描边幽灵胶囊，不用主色实心，免得整列都在喊 */
.bcancel {
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--glass-line);
  background: var(--glass);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  color: var(--t2);
  font-size: 22rpx;
  line-height: 44rpx;
  flex: none;
}

.bhint {
  display: block;
  margin: 26rpx 40rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--t3);
}

/* ------------------------------------------------------------------ 空态 */
.empty {
  padding: 120rpx 90rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.emp-ic {
  width: 152rpx;
  height: 152rpx;
  border-radius: 48rpx;
  background: var(--cream);
  display: flex;
  align-items: center;
  justify-content: center;
}

.emp-t {
  display: block;
  margin-top: 36rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
}

.emp-s {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--t2);
  text-align: center;
}

.emp-btn {
  margin-top: 48rpx;
  padding: 0 48rpx;
}

/* 空态里那枚日历（比「我的」列表里的略大一圈） */
.ic-cal.big {
  width: 40rpx;
  height: 38rpx;
  border-width: 4rpx;
  border-radius: 8rpx;
}

.ic-cal.big::before {
  left: -4rpx;
  top: -4rpx;
  width: 40rpx;
  height: 10rpx;
  border-radius: 6rpx 6rpx 0 0;
}

.ic-cal.big::after {
  left: 9rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
}

/* 尾注 */
.tail {
  padding: 40rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 20rpx;
  color: var(--t3);
}
