/* ============================================================================
   活动详情 —— 「活动介绍 / 小科普 / 温馨提示」
   这一页刻意不做打卡：没有邮戳、没有动线、没有成就章。
   打卡从这个页面最下方「活动地点」那张卡走。
   ========================================================================== */

/* ------------------------------------------------------------------ 封面 */
.hero {
  position: relative;
  margin: 24rpx 40rpx 0;
  padding: 22rpx;
}

.himg-wrap {
  position: relative;
  height: 340rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.himg {
  width: 100%;
  height: 100%;
  display: block;
}

.hday {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--glass-lit);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--t1);
  line-height: 1;
}

.hprice {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--ink);
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 700;
}

/* 压在封面角上的两片和纸胶带 */
.hw1 {
  left: -10rpx;
  top: -12rpx;
  width: 150rpx;
  height: 44rpx;
  transform: rotate(-9deg);
}

.hw2 {
  right: -12rpx;
  bottom: -10rpx;
  width: 130rpx;
  height: 40rpx;
  transform: rotate(7deg);
}

/* ------------------------------------------------------------------ 标题 */
.head {
  padding: 32rpx 40rpx 0;
}

.nm {
  display: block;
  font-size: 44rpx;
  line-height: 1.3;
  color: var(--t1);
}

.sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--t2);
}

/* ------------------------------------------------------------------ 时间 / 地点 / 备注 */
.meta {
  margin: 28rpx 40rpx 0;
  padding: 6rpx 30rpx;
}

.mrow {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
}

.mk {
  flex: none;
  width: 96rpx;
  font-size: 25rpx;
  color: var(--t3);
}

.mv {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--t1);
}

/* ------------------------------------------------------------------ 内容卡 */
.sec {
  margin: 28rpx 40rpx 0;
  padding: 34rpx 32rpx 36rpx;
}

.sec-hd {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.hd-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex: none;
  margin-right: 14rpx;
}

.sec-h {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--t1);
}

.sec-tag {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--t3);
}

/* 活动介绍：两段正文 */
.para {
  display: block;
  font-size: 27rpx;
  line-height: 1.85;
  color: var(--t2);
}

.para + .para {
  margin-top: 16rpx;
}

/* 小科普：薄荷底的小方卡，跟正文区分开 */
.kn {
  padding: 22rpx 24rpx;
  /* 与同页的「温馨提示」.pl 同级 —— 一起做半透，色相（薄荷）保留 */
  background: var(--glass-mint);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid var(--glass-line);
  border-radius: 28rpx;
}

.kn + .kn {
  margin-top: 18rpx;
}

.kn-t {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--green);
}

.kn-d {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--t2);
}

/* 温馨提示：沙底卡 + 金点列表 */
.tp {
  display: flex;
  align-items: flex-start;
}

.tp + .tp {
  margin-top: 16rpx;
}

.tp-i {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--gold);
  margin: 13rpx 16rpx 0 0;
}

.tp-t {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6B5A34;
}

/* ------------------------------------------------------------------ 活动地点（打卡入口） */
.pl {
  display: flex;
  align-items: center;
  padding: 18rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid var(--glass-line);
  border-radius: 30rpx;
}

.pl-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: var(--glass-lit);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.pl-img {
  width: 80%;
  height: 80%;
}

.pl-col {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.pl-n {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--t1);
}

.pl-d {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--t3);
}

/* ------------------------------------------------------------------ 页脚 */
.tail {
  padding: 40rpx 40rpx calc(220rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 20rpx;
  color: var(--t3);
}
